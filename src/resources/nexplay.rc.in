#include <windows.h>
#include "resource.h"
IDI_NEXPLAY ICON "@NEXPLAY_ICON_FILE@"
UPDATER_SCRIPT RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/src/update/Updater.ps1"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zimonxx"
      VALUE "FileDescription", "NexPlay - Replay Studio"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "nexplay"
      VALUE "LegalCopyright", "Copyright (c) 2026 Zimonxx and NexPlay contributors"
      VALUE "OriginalFilename", "nexplay.exe"
      VALUE "ProductName", "NexPlay"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
